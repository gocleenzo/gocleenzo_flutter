	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!--
	  Firebase Phone Auth on iOS falls back to an in-browser reCAPTCHA
	  verification (SMS auto-retrieval isn't available on iOS), which
	  redirects back into the app via the custom URL scheme registered
	  below. Firebase's own SDK is meant to silently intercept and consume
	  that redirect to finish signing the user in.

	  By default, Flutter's iOS engine ALSO forwards every incoming URL to
	  go_router for its own deep-link handling. Since this app registers no
	  routes for Firebase's auth-callback URL, go_router showed a
	  "Page Not Found" screen on top of/instead of the login completing —
	  the exact bug this key fixes. This app doesn't use deep links for
	  anything else (no shared links, no password-reset links routed
	  through go_router), so disabling Flutter's deep-link forwarding
	  entirely is safe and lets Firebase's native SDK handle its own
	  callback exclusively, uncontested.
	-->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<!-- Firebase Phone Auth — reCAPTCHA URL scheme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.404053308024-deb7js0n61c5pavue2ff2kkusgai80qs</string>
			</array>
		</dict>
	</array>
	<!-- Google Maps API Key -->
	<key>GMSApiKey</key>
	<string>AIzaSyCwm6IDpINuP3K7XH9Zy9sL7C-ACR_UgWU</string>
	<key>io.flutter.embedded_views_preview</key>
	<true/>
	<!-- Location permissions -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Cleenzo needs your location to show nearby services and confirm your address.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Cleenzo needs your location to show nearby services.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Cleenzo needs your location to show nearby services.</string>
	<!-- Camera & Photos -->
	<key>NSCameraUsageDescription</key>
	<string>Cleenzo needs camera access for profile photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cleenzo needs photo library access for profile photos.</string>
	<!-- Background modes for notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
